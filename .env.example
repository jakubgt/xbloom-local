# The application reads process environment, not this file automatically.
# PowerShell: $env:XBLOOM_DATA_DIR = 'C:\xbloom-data'
# systemd: use EnvironmentFile=/etc/xbloom-local.env (see deployment guide).
XBLOOM_DATA_DIR=./data
XBLOOM_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
XBLOOM_SECURE_COOKIES=false
XBLOOM_LAN_ONLY=true
XBLOOM_AUTH_MODE=password
# Optional: trusted_lan opens the dashboard without an account or sign-in.
# Anyone allowed onto the dashboard's LAN can use it. Keep network restrictions.
# Bridge and import clients still require their own scoped tokens.

# In password mode, credentials are initialized interactively and stored hashed.
# Never put passwords, API tokens, or Proxmark dumps in a tracked file.
