XBLOOM_DATA_DIR=/var/lib/xbloom-local
# Replace the sample address with the LXC's reserved LAN address.
XBLOOM_ALLOWED_HOSTS=192.168.1.50,localhost,127.0.0.1
XBLOOM_SECURE_COOKIES=true
XBLOOM_LAN_ONLY=true
XBLOOM_AUTH_MODE=password
# Use trusted_lan to open the dashboard without account setup or sign-in.
# Anyone on the allowed LAN can use it; retain the Caddy and firewall LAN limits.
# Bridge and import clients still require their own scoped tokens.
