[Unit]
Description=xBloom Local Recipe Manager
After=network.target

[Service]
Type=simple
User=xbloom
Group=xbloom
WorkingDirectory=/opt/xbloom-local
EnvironmentFile=/etc/xbloom-local.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/xbloom-local/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xbloom-local

[Install]
WantedBy=multi-user.target
